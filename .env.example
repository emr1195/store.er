# URL pública de la aplicación, sin barra final
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# Sanity. El dataset debe ser privado porque contiene pedidos y datos personales.
NEXT_PUBLIC_SANITY_PROJECT_ID=replace_me
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-05-01
SANITY_API_READ_TOKEN=replace_with_viewer_token
SANITY_API_TOKEN=replace_with_server_editor_token

# Stripe
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Pricing (valores no secretos usados también para la vista previa del carrito)
STORE_CURRENCY=USD
NEXT_PUBLIC_ITBMS_RATE=0.07
NEXT_PUBLIC_STANDARD_SHIPPING_CENTS=0
